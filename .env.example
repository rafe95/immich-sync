# --- docker compose (production) ---------------------------------------------
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
SECRET_KEY=
TZ=Europe/Lisbon
# ADMIN_PASSWORD is the bootstrap/recovery login. After a password change in Settings, the stored
# hash takes precedence. To fall back to ADMIN_PASSWORD: delete from settings where key = 'admin_password_hash';
# Set true ONLY behind a reverse proxy that sets X-Forwarded-For (login backoff then uses the first
# hop instead of the proxy's address). Never enable it when the app is reachable directly.
# TRUST_PROXY=false

# --- container runtime for the bun run db:* / app:* scripts -----------------------
# docker, podman or auto (default: docker if installed, otherwise podman).
# CONTAINER_RUNTIME=auto

# --- local development (bun run dev) ------------------------------------------
# Matches docker-compose.dev.yml. Comment out when using this file for docker compose.
DATABASE_URL=postgres://immich_sync:devpassword@localhost:55432/immich_sync
PORT=8080
